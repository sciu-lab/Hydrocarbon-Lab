{
  "name": "hydrocarbon-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "dev:pages": "vite --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "build": "bash scripts/build-verified.sh",
    "build:pages": "vite build --config vite.pages.config.ts",
    "validate:pages": "node scripts/validate-pages.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:critical": "node --test --test-concurrency=1 tests/exercise-model.test.mjs tests/exercise-domain.test.mjs tests/practice-structural-answer.test.mjs tests/difficulty-plumbing.test.mjs tests/difficulty-easy-session.test.mjs tests/difficulty-intermediate-session.test.mjs tests/difficulty-hard-foundation.test.mjs tests/difficulty-hard-frozen.test.mjs tests/practice-session.test.mjs tests/practice-007b-duplicate-integrity.test.mjs tests/practice-008-reference-answer.test.mjs tests/exam-session.test.mjs",
    "test:reference-corpus": "node --test --test-concurrency=1 tests/reference-corpus-schema.test.mjs tests/reference-name-corpus.test.mjs tests/reference-roundtrip.test.mjs tests/reference-corpus-coverage.test.mjs",
    "report:reference-corpus": "node scripts/report-reference-corpus.mjs",
    "audit:reference-corpus": "node scripts/audit-reference-corpus.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "docx:proof": "node scripts/docx-1-proof.mjs",
    "docx:mcq-proof": "node scripts/docx-1-proof.mjs --mcq",
    "test:docx-ui": "node --test tests/docx-export-ui.test.mjs tests/docx-export.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern dist-pages --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "docx": "9.8.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "openchemlib": "^9.25.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "ajv": "6.15.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "sharp": "0.34.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Sciu Science · Hydrocarbon Lab"
}
